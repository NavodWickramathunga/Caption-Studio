# The AI key. This one is yours, not the customer's — it is the whole
# point of the server. Get it from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Sign-in. Create an OAuth *Web application* client at
# https://console.cloud.google.com/apis/credentials and add your site's
# origin (e.g. http://localhost:3000) to "Authorised JavaScript origins".
# No client secret is needed — this uses the token flow.
GOOGLE_CLIENT_ID=

# Signs the session cookie. Any long random string; changing it signs
# everyone out.  Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the SQLite file lives. On a host with a mounted volume, point
# this at the volume or the accounts vanish on the next deploy.
# CAPTION_DB=/data/caption-studio.db
